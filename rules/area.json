{
  "version": "2026.09.30-1",
  "kind": "area",
  "note": "Priority-ordered area assignment (thesis: area_for(record)). First match wins. Areas: insolvency, court, third_party_attachment, enforcement, pre_enforcement, payment_order, civil_litigation, local_tax, tax, collection, social_security, banking, out_of_court_recovery.",
  "rules": [
    {"id": "AR-000", "when": {"doc_type": ["ricorso_liquidazione_giudiziale", "sentenza_liquidazione_giudiziale"]},
     "then": {"area": "insolvency"},
     "rationale": "exception above the court override: insolvency acts come from the court but belong to the insolvency desk",
     "tests": [{"id": "AR-000-a", "input": {"doc_type": "sentenza_liquidazione_giudiziale", "sender_domain": "crisi.civile.tribunale.example"}, "expect": {"area": "insolvency"}}]},
    {"id": "AR-001", "when": {"doc_type": "RECUPERARE"},
     "then": {"area": "RECUPERARE"},
     "rationale": "no document type, no area: null is honest",
     "tests": [{"id": "AR-001-a", "input": {"doc_type": "RECUPERARE", "sender_domain": "civile.tribunale.example"}, "expect": {"area": "RECUPERARE"}}]},
    {"id": "R-001", "when": {"sender_domain": "tribunale.example"},
     "then": {"area": "court"},
     "rationale": "court filings override topic heuristics",
     "tests": ["S03-notice-2", {"id": "R-001-a", "input": {"doc_type": "comunicazione_cancelleria", "sender_domain": "civile.tribunale.example"}, "expect": {"area": "court"}}]},
    {"id": "AR-010", "when": {"doc_type": "pignoramento_presso_terzi"},
     "then": {"area": "third_party_attachment"},
     "rationale": "garnishment has its own desk (bank relations, art. 543 ss. c.p.c.)",
     "tests": [{"id": "AR-010-a", "input": {"doc_type": "pignoramento_presso_terzi", "sender_domain": "pec.bancaaurora.example"}, "expect": {"area": "third_party_attachment"}}]},
    {"id": "AR-011", "when": {"doc_type": "pignoramento_mobiliare"},
     "then": {"area": "enforcement"},
     "rationale": "enforcement proper",
     "tests": [{"id": "AR-011-a", "input": {"doc_type": "pignoramento_mobiliare"}, "expect": {"area": "enforcement"}}]},
    {"id": "AR-012", "when": {"doc_type": "atto_precetto"},
     "then": {"area": "pre_enforcement"},
     "rationale": "precetto precedes enforcement: 10-day window to act",
     "tests": [{"id": "AR-012-a", "input": {"doc_type": "atto_precetto"}, "expect": {"area": "pre_enforcement"}}]},
    {"id": "AR-013", "when": {"doc_type": "decreto_ingiuntivo"},
     "then": {"area": "payment_order"},
     "rationale": "monitory procedure",
     "tests": [{"id": "AR-013-a", "input": {"doc_type": "decreto_ingiuntivo"}, "expect": {"area": "payment_order"}}]},
    {"id": "AR-014", "when": {"doc_type": "atto_citazione"},
     "then": {"area": "civil_litigation"},
     "rationale": "ordinary civil proceedings",
     "tests": [{"id": "AR-014-a", "input": {"doc_type": "atto_citazione"}, "expect": {"area": "civil_litigation"}}]},
    {"id": "AR-015", "when": {"doc_type": "avviso_accertamento", "text_matches": "^\\s*COMUNE DI\\b|\\bIMU\\b|\\bTARI\\b|tributi locali"},
     "then": {"area": "local_tax"},
     "rationale": "local-tax assessments (IMU/TARI) go to a different office than State taxes",
     "tests": [{"id": "AR-015-a", "input": {"doc_type": "avviso_accertamento", "text": "COMUNE DI ESEMPIO\nAVVISO DI ACCERTAMENTO IMU"}, "expect": {"area": "local_tax"}}]},
    {"id": "AR-016", "when": {"doc_type": "avviso_accertamento"},
     "then": {"area": "tax"},
     "rationale": "State tax assessment",
     "tests": [{"id": "AR-016-a", "input": {"doc_type": "avviso_accertamento", "text": "AGENZIA ESEMPIO ENTRATE"}, "expect": {"area": "tax"}}]},
    {"id": "R-014", "when": {"doc_type": "cartella_pagamento"},
     "then": {"area": "collection"},
     "rationale": "default for tax collection notices: handled by the collection desk",
     "tests": ["S02-notice-1", {"id": "R-014-a", "input": {"doc_type": "cartella_pagamento"}, "expect": {"area": "collection"}}]},
    {"id": "AR-017", "when": {"doc_type": ["intimazione_pagamento", "provvedimento_rateizzazione"]},
     "then": {"area": "collection"},
     "rationale": "collection agent acts after the cartella",
     "tests": [{"id": "AR-017-a", "input": {"doc_type": "provvedimento_rateizzazione"}, "expect": {"area": "collection"}}]},
    {"id": "AR-018", "when": {"doc_type": "avviso_addebito"},
     "then": {"area": "social_security"},
     "rationale": "social-security contributions",
     "tests": [{"id": "AR-018-a", "input": {"doc_type": "avviso_addebito"}, "expect": {"area": "social_security"}}]},
    {"id": "AR-019", "when": {"doc_type": ["diffida_messa_in_mora", "sollecito_pagamento"], "sender_class": "BANK_CORPORATE"},
     "then": {"area": "banking"},
     "rationale": "a bank demanding its own credit is a banking-relations matter",
     "tests": [{"id": "AR-019-a", "input": {"doc_type": "diffida_messa_in_mora", "sender_class": "BANK_CORPORATE"}, "expect": {"area": "banking"}}]},
    {"id": "AR-020", "when": {"doc_type": ["diffida_messa_in_mora", "sollecito_pagamento"]},
     "then": {"area": "out_of_court_recovery"},
     "rationale": "out-of-court recovery",
     "tests": [{"id": "AR-020-a", "input": {"doc_type": "sollecito_pagamento", "sender_class": "CORPORATE_PEC"}, "expect": {"area": "out_of_court_recovery"}}]},
    {"id": "AR-021", "when": {"doc_type": "comunicazione_cancelleria"},
     "then": {"area": "court"},
     "rationale": "registry communications not sent from a court domain (e.g. forwarded)",
     "tests": [{"id": "AR-021-a", "input": {"doc_type": "comunicazione_cancelleria", "sender_domain": "pec.fornaceaurelia.example"}, "expect": {"area": "court"}}]}
  ]
}
