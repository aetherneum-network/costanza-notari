          }
        }
      ]
    },
    {
      "id": "N-008",
      "when": {
        "before": "(?:\\b(?:udienz[ae]|comparizione|rat[ae]|scadenz[ae]|termin[ei])\\b(?:(?!\\b(?:non|se|salvo|dopo|prima|oltre|qualora|ove)\\b)[^.;:]){0,80}?\\b(?:(?!potr)\\w+(?:rà|ranno)|(?:(?:dovrà|dovranno|deve|devono)\\s+(?:essere\\s+\\w+[aeio]|\\w+(?:are|ere|ire))\\b|(?:va|vanno)\\s+(?:essere\\s+)?\\w+[aeio]\\b)|(?:è|sono|viene|vengono)\\s+(?:stat[oaie]\\s+)?(?:fissat|rinviat|differit|stabilit|calendarizzat|aggiornat)[oaie])|\\b(?:pagament[oi]|versament[oi]|adempiment[oi]|saldo)\\b(?:(?!\\b(?:non|se|salvo|dopo|prima|oltre|qualora|ove)\\b)[^.;:]){0,80}?\\b(?:(?:dovrà|dovranno|deve|devono)\\s+(?:essere\\s+\\w+[aeio]|\\w+(?:are|ere|ire))\\b|(?:va|vanno)\\s+(?:essere\\s+)?\\w+[aeio]\\b))(?:\\s+(?!(?:non|se|salvo|dopo|prima|oltre|qualora|ove)\\b)[\\w'’]+){0,4}?\\s+(?:il|al|per\\s+il|entro\\s+il|in\\s+data|il\\s+giorno|per\\s+il\\s+giorno|al\\s+giorno|alla\\s+data\\s+del)\\s*$",
        "date_vs_reference": "after",
        "across_a_date": "RECUPERARE"
      },
      "then": {
        "nature": "actionable",
        "sole_candidate": true
      },
      "rationale": "structural reading of a stated term: a term noun governed by a verb whose complement is the date: udienza / comparizione / rata / scadenza / termine with a future, deontic or 'è fissata' verb; pagamento / versamento / adempimento / saldo only with a DEONTIC verb (dovrà essere effettuato, deve avvenire, va eseguito) - 'il pagamento avverrà il' does not say who pays and is not read; in short a term noun governed by a future or deontic verb (si terrà, dovrà essere corrisposta, è fissata, va versato) whose complement is the date. Only for dates after the notification; a negation, 'se', 'salvo', 'dopo', 'prima' between the noun and the date breaks the structure; conditional (N-001) and past-modal (N-002) clauses are decided before this rule; 'potrà' states a possibility, not a term. This rule reads wordings the cue rules of v2.0 did not, so its reading is accepted only when the text writes no other future date that is or may be a term (sole_candidate): with two dates an enumeration (the earliest drives) cannot be told from a postponement (the latest replaces the earliest). across_a_date: the noun and the verb must not be separated from each other by another date ('la rata del 30/10/2026 sarà addebitata il 15/11/2026' names two dates for one rata): unknown nature",
      "tests": [
        {
          "id": "N-008-a",
          "input": {
            "before": "a comparire all'udienza che si terrà il",
            "after": " ore 9:30",
            "date": "2026-11-12",
            "reference": "2026-10-02"
