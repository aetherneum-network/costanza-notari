{
  "version": "2026.10.01-3",
  "kind": "deadline_nature",
  "note": "Ordered, first match wins. 'before' = text of the same sentence preceding the date (anchored patterns end with $: the cue must sit immediately before the date); 'after' = text following the date in the same sentence. N-000 runs first when the notification date is known. Unmatched future date -> RECUPERARE (surfaced, never driving). v2.1: N-008 reads a term by its STRUCTURE (term noun + future/deontic verb + linker + date) instead of a fixed phrase; N-009 recognises the 'Place, date' line. A test may carry 'expect_rule' when it proves that ANOTHER rule (or none: N-FALLBACK) must win. v2.1 safety: 'after_not' = the rule does not apply when the text after the date matches; 'max_days_after_reference' = the rule applies only to dates at most N days after the reference; then.sole_candidate = the reading is accepted only if the text writes no other future date that is or may be a term (pipeline/classify.py, competing_written_dates); 'vetoes' = applied to every reading of the given nature, whatever rule made it. 'before_local' = the part of 'before' that follows the previous date of the same sentence (tests that omit it use 'before'); when.across_a_date = nature answered when the 'before' pattern matches only by reading across that previous date; a veto may look at the text after the date (when.after) or at the local lead-in (when.before).",
  "rules": [
    {
      "id": "N-000",
      "when": {
        "date_vs_reference": "on_or_before"
      },
      "then": {
        "nature": "historical"
      },
      "rationale": "a date on or before the notification date cannot be a future term (a past hearing, an invoice, the document date)",
      "tests": [
        {
          "id": "N-000-a",
          "input": {
            "before": "udite le parti all'udienza del",
            "after": "",
            "date": "2026-09-10",
            "reference": "2026-10-02"
          },
          "expect": {
            "nature": "historical"
          }
        },
        {
          "id": "N-000-b",
          "input": {
            "before": "Esempio, ",
            "after": "",
            "date": "2026-10-01",
            "reference": "2026-10-02"
          },
          "expect": {
            "nature": "historical"
          }
        }
      ]
    },
    {
      "id": "N-001",
      "when": {
        "before": "\\b(qualora|in caso di|nel caso in cui|laddove|a condizione che|ove non)\\b[^.;]*$"
      },
      "then": {
        "nature": "conditional"
      },
      "rationale": "a condition governs the clause: drives urgency only when triggered",
      "tests": [
        {
          "id": "N-001-a",
          "input": {
            "before": "qualora entro il",
            "after": " non pervenga il pagamento"
          },
          "expect": {
            "nature": "conditional"
          }
        }
      ]
    },
    {
      "id": "N-002",
      "when": {
        "before": "\\b(doveva(no)?|avrebbe(ro)? dovuto|era(no)? tenut[oaie]|originariamente|in precedenza|precedentemente|annulla e sostituisce)\\b[^.;]*$",
        "across_a_date": "RECUPERARE"
      },
      "then": {
        "nature": "historical"
      },
      "rationale": "past modal or superseded term: the date is a recital, even if 'entro il' follows v2.1 (across_a_date): when the cue is found only by reading across an earlier date of the same sentence ('originariamente prevista per il 12/11/2026, si terrà il 15/12/2026') it may belong to that date alone: the nature is unknown, not historical",
      "tests": [
        {
          "id": "N-002-a",
          "input": {
            "before": "il pagamento doveva avvenire entro il",
            "after": ""
          },
          "expect": {
            "nature": "historical"
          }
        },
        {
          "id": "N-002-b",
          "input": {
            "before": "il termine originariamente fissato al",
            "after": " deve intendersi superato"
          },
          "expect": {
            "nature": "historical"
          }
        },
        {
          "id": "N-002-across",
          "input": {
            "before": "L'udienza, originariamente prevista per il 12/11/2026, si terrà il",
            "before_local": ", si terrà il",
            "date": "2026-12-15",
            "reference": "2026-10-02"
          },
          "expect": {
            "nature": "RECUPERARE"
          }
        },
        {
          "id": "N-002-across-neg",
          "input": {
            "before": "La rata del 30/09/2026 doveva essere versata entro il",
            "before_local": " doveva essere versata entro il",
            "date": "2026-12-15",
            "reference": "2026-10-02"
          },
          "expect": {
            "nature": "historical"
          },
          "comment": "the cue sits between the two dates: it governs this one"
        }
      ]
    },
    {
      "id": "N-003",
      "when": {
        "before": "\\b(scadut[oaie]|decors[oaie]|spirat[oaie])\\s+(il|in data)?\\s*$"
      },
      "then": {
        "nature": "historical"
      },
      "rationale": "'scaduta il' - an expired term, not a deadline",
      "tests": [
        {
          "id": "N-003-a",
          "input": {
            "before": "fattura n. 118, scaduta il",
            "after": ""
          },
          "expect": {
            "nature": "historical"
          }
        }
      ]
    },
    {
      "id": "N-004",
      "when": {
        "after": "^\\W*(non è stat[oa] rispettat|non sono stati rispettati|è scadut|è decors|è spirat|risulta scadut|è stat[oa] revocat|deve intendersi superat)"
      },
      "then": {
        "nature": "historical"
      },
      "rationale": "'the term of 2025-06-30 was not met'",
      "tests": [
        {
          "id": "N-004-a",
          "input": {
            "before": "il termine del",
            "after": " non è stato rispettato"
          },
          "expect": {
            "nature": "historical"
          }
        }
      ]
    },
    {
      "id": "N-005",
      "when": {
        "before": "(entro\\s+(e\\s+non\\s+oltre\\s+)?il|entro\\s+la\\s+data\\s+del|udienza\\s+(del|fissata\\s+(per\\s+il|al)|al)|rinviat[oa]\\s+(l['’]\\s*)?udienza\\s+al|scade\\s+il|scadrà\\s+il|con\\s+scadenza\\s+(il|al)|scadenza:?\\s*(il|del|al)?|termine\\s+ultimo\\s+(del|il)|da\\s+versare\\s+entro\\s+il|fissat[oa]\\s+(per\\s+il|al)|comparire\\s+(il|all['’]\\s*udienza\\s+del))\\s*$"
      },
      "then": {
        "nature": "actionable"
      },
      "rationale": "an explicit future term or hearing",
      "tests": [
        {
          "id": "N-005-a",
          "input": {
            "before": "a comparire all'udienza del",
            "after": " ore 9:30"
          },
          "expect": {
            "nature": "actionable"
          }
        },
        {
          "id": "N-005-b",
          "input": {
            "before": "La prima rata scade il",
