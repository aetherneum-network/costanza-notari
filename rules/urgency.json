{
  "version": "2026.09.30-1",
  "kind": "urgency",
  "levels": [
    "MAXIMUM",
    "HIGH",
    "MEDIUM",
    "LOW",
    "INFORMATIONAL"
  ],
  "note": "Days are counted from the as_of date to the driving deadline (earliest open actionable/computed term; else latest expired). Ordered, first match wins; floors applied afterwards. U-002/U-002B: see rationale; changed after the first full run showed 189/286 MAXIMUM (CHANGELOG).",
  "rules": [
    {
      "id": "U-000",
      "when": {
        "doc_type_unknown": true
      },
      "then": {
        "urgency": "MAXIMUM"
      },
      "rationale": "unknown act, unknown term: assume the worst and show it",
      "tests": [
        {
          "id": "U-000-a",
          "input": {
            "doc_type": "RECUPERARE"
          },
          "expect": {
            "urgency": "MAXIMUM"
          }
        }
      ]
    },
    {
      "id": "U-001",
      "when": {
        "deadline_recuperare": true
      },
      "then": {
        "urgency": "MAXIMUM"
      },
      "rationale": "the act carries a term we could not establish: conservative",
      "tests": [
        {
          "id": "U-001-a",
          "input": {
            "doc_type": "atto_precetto",
            "deadline": "RECUPERARE"
          },
          "expect": {
            "urgency": "MAXIMUM"
          }
        }
      ]
    },
    {
      "id": "U-002",
      "when": {
        "status": "expired",
        "expired_within_days": 15
      },
      "then": {
        "urgency": "MAXIMUM"
      },
      "rationale": "a term that expired in the last 15 days needs a human decision today (was it met?)",
      "tests": [
        {
          "id": "U-002-a",
          "input": {
            "doc_type": "cartella_pagamento",
            "days_left": -3
          },
          "expect": {
            "urgency": "MAXIMUM"
          }
        }
      ]
    },
    {
      "id": "U-002B",
      "when": {
        "status": "expired"
      },
      "then": {
        "urgency": "LOW"
      },
      "rationale": "long-expired terms stay visible (deadline status 'expired') but must not drown the red of imminent ones: if everything is MAXIMUM, nothing is",
      "tests": [
        {
          "id": "U-002B-a",
          "input": {
            "doc_type": "atto_precetto",
            "days_left": -90
          },
          "expect": {
            "urgency": "LOW"
          }
        }
      ]
    },
    {
      "id": "U-003",
      "when": {
        "max_days": 10
      },
      "then": {
        "urgency": "MAXIMUM"
      },
      "rationale": "10 days: the precetto window",
      "tests": [
        {
          "id": "U-003-a",
          "input": {
            "doc_type": "atto_precetto",
            "days_left": 10
          },
          "expect": {
            "urgency": "MAXIMUM"
          }
        }
      ]
    },
    {
      "id": "U-004",
      "when": {
        "max_days": 30
      },
      "then": {
        "urgency": "HIGH"
      },
      "rationale": "within a month",
      "tests": [
        {
          "id": "U-004-a",
          "input": {
            "doc_type": "decreto_ingiuntivo",
            "days_left": 11
          },
          "expect": {
            "urgency": "HIGH"
          }
        }
      ]
    },
    {
      "id": "U-005",
      "when": {
        "max_days": 60
      },
      "then": {
        "urgency": "MEDIUM"
      },
      "rationale": "within two months",
      "tests": [
        {
          "id": "U-005-a",
          "input": {
            "doc_type": "cartella_pagamento",
            "days_left": 45
          },
          "expect": {
            "urgency": "MEDIUM"
          }
        }
      ]
    },
    {
      "id": "U-006",
      "when": {
        "has_deadline": true
      },
      "then": {
        "urgency": "LOW"
      },
      "rationale": "far deadline",
      "tests": [
        {
          "id": "U-006-a",
          "input": {
            "doc_type": "avviso_accertamento",
            "days_left": 90
          },
          "expect": {
            "urgency": "LOW"
          }
        }
      ]
    },
    {
      "id": "U-007",
      "when": {},
      "then": {
        "urgency": "INFORMATIONAL"
      },
      "rationale": "no driving deadline",
      "tests": [
        {
          "id": "U-007-a",
          "input": {
            "doc_type": "sollecito_pagamento"
          },
          "expect": {
            "urgency": "INFORMATIONAL"
          }
        }
      ]
    }
  ],
  "floors": [
    {
      "id": "UF-001",
      "doc_type": [
        "ricorso_liquidazione_giudiziale",
        "sentenza_liquidazione_giudiziale"
      ],
      "min": "HIGH",
      "rationale": "insolvency acts are never below HIGH"
    }
  ],
  "colors": {
    "MAXIMUM": {
      "fill": "C00000",
      "font": "FFFFFF",
      "bold": true
    },
    "HIGH": {
      "fill": "F4B183",
      "font": "000000",
      "bold": true
    },
    "MEDIUM": {
      "fill": "FFE699",
      "font": "000000",
      "bold": false
    },
    "LOW": {
      "fill": "C6EFCE",
      "font": "000000",
      "bold": false
    },
    "INFORMATIONAL": {
      "fill": "D9D9D9",
      "font": "000000",
      "bold": false
    },
    "RECUPERARE": {
      "fill": "FFFF00",
      "font": "FF0000",
      "bold": true
    }
  }
}
